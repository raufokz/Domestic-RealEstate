APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Geo Access Control — see GEO_ACCESS_CONTROL.md
# Shared secret with the Next.js frontend's server-only GEO_INTERNAL_SECRET
GEO_INTERNAL_SECRET=
# Free MaxMind account license key (geolite.info) — enables country-based
# blocking via `php artisan geo:refresh-intelligence`. Leave blank to run
# with Tor/datacenter-ASN blocking only (country blocking fails open).
GEOIP_LICENSE_KEY=

# Payoneer — requires an approved partner account (not self-serve like
# Stripe). See PAYMENTS.md. Until set, PayoneerService throws a clear
# "not configured" error instead of faking payment success.
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_PROGRAM_ID=
PAYONEER_WEBHOOK_SECRET=
PAYONEER_ENV=sandbox

# Cloudflare Turnstile — free, unlimited spam protection on public lead
# forms. Create a free site at https://dash.cloudflare.com/?to=/:account/turnstile
# and paste both keys below. Until TURNSTILE_SECRET_KEY is set,
# TurnstileVerifier passes every submission through unchecked (no CAPTCHA
# widget is rendered on the frontend either, since NEXT_PUBLIC_TURNSTILE_SITE_KEY
# is also unset) — forms keep working, just without spam protection.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI providers — AiService falls back Gemini -> OpenAI -> Claude, using
# whichever have real (non-placeholder) keys set. See config/ai.php for
# per-provider cost-per-token rates used to estimate spend in ai_usage_logs.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shared secret required on the POST /api/webhooks/email/bounce endpoint
# (X-Webhook-Secret header). Generate a random value once you wire up a real
# ESP (SendGrid/Postmark/SES) adapter in front of it. Left unset, the
# endpoint fails closed and returns 501.
EMAIL_BOUNCE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
