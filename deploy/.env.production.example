APP_NAME="Domestic Real Estate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.domesticrealestate.us

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_production_db_name
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_production_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.domesticrealestate.us

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Brevo (formerly Sendinblue) SMTP relay — get the login/SMTP key from
# Brevo dashboard > SMTP & API > SMTP tab. Sender identity below must match
# a domain/sender verified in that Brevo account or sends will be rejected.
# NOTE: these env values are only the fallback used before the DB boots —
# once email_settings has a row, EmailMailConfigurator (app/Services)
# overrides them from Admin > Email Settings, so set the real values there.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_login_email
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@domesticrealestate.us"
MAIL_FROM_NAME="Domestic Real Estate"

AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=domestic-re-assets
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=domesticrealestate.us,www.domesticrealestate.us

FRONTEND_URL=https://domesticrealestate.us

GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

GOOGLE_MAPS_API_KEY=your_google_maps_key

TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

SENDGRID_API_KEY=your_sendgrid_api_key

VITE_APP_NAME="${APP_NAME}"
