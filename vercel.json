{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd nextjs-frontend && npm install",
  "buildCommand": "cd nextjs-frontend && npm run build",
  "outputDirectory": "nextjs-frontend/.next",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.domesticrealestate.us"
        }
      ],
      "destination": "https://domesticrealestate.us/:path*",
      "permanent": true
    }
  ]
}
